# Kotlin/Gradle sources are LF in the repo regardless of contributor platform,
# so an editor that rewrites a file with CRLF cannot inflate its diff.
*.kt   text eol=lf
*.kts  text eol=lf
# Recorded HTTP fixtures hold response bodies byte for byte; a line-ending conversion would change their size.
**/fixtures/**/*.http -text
# Feed test documents hold bytes that tests compare; a line-ending conversion would change them.
webtools-feeds/src/jvmTest/resources/feeds/** -text
